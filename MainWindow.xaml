<Window x:Class="AoTPresetEditor.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AoTPresetEditor"
 Title="AoT Preset Editor" Width="1400" Height="900" MinWidth="1050" MinHeight="650"
 FontFamily="Segoe UI" FontSize="14" Background="#F3F5F8" WindowStartupLocation="CenterScreen">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18">
   <Border DockPanel.Dock="Right" Background="#DFEAE6" CornerRadius="5" Padding="12,6" VerticalAlignment="Center"><TextBlock Text="PRESET EDITOR" Foreground="#22604B" FontSize="12" FontWeight="SemiBold"/></Border>
   <StackPanel><TextBlock Text="AoT Preset Editor" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Create presets from named rules, shared settings, and templates" Foreground="#5B687B" Margin="0,4,0,0"/></StackPanel>
  </DockPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,16">
   <Button x:Name="ReloadButton" DockPanel.Dock="Right" Content="Reload" Click="Reload_Click"/>
   <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Data folder..." Click="Browse_Click"/>
   <TextBox x:Name="DataPath" IsReadOnly="True" AutomationProperties.Name="Skyrim Data folder" ToolTip="Launch through MO2 to read the selected profile's files."/>
  </DockPanel>
  <TabControl Grid.Row="2" Background="White" BorderBrush="#D5DBE5">
   <TabItem Header="Forms">
    <Grid Margin="16">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0"><TextBlock Text="Search name, EditorID, ID, or plugin" Margin="0,0,0,5"/><TextBox x:Name="Search" TextChanged="Filter_Changed" AutomationProperties.Name="Search forms"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Record type" Margin="0,0,0,5"/><ComboBox x:Name="Types" SelectionChanged="Filter_Changed" AutomationProperties.Name="Record type"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Origin or winning plugin" Margin="0,0,0,5"/><ComboBox x:Name="Plugins" SelectionChanged="Filter_Changed" AutomationProperties.Name="Plugin filter"/></StackPanel>
     </Grid>
     <TextBlock x:Name="ResultCount" Grid.Row="1" Margin="0,12,0,8" Foreground="#5B687B"/>
     <DataGrid x:Name="FormGrid" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF0F4" BorderBrush="#E0E5EC" RowHeight="30" EnableRowVirtualization="True" SelectionMode="Single" SelectionChanged="Form_Selected">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
       <DataGridTextColumn Header="EditorID" Binding="{Binding EditorId}" Width="2*"/>
       <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110"/>
       <DataGridTextColumn Header="Defined in" Binding="{Binding Plugin}" Width="*"/>
       <DataGridTextColumn Header="Winning plugin" Binding="{Binding Winner}" Width="*"/>
      </DataGrid.Columns>
     </DataGrid>
     <DockPanel Grid.Row="3" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="Copy identifier" Click="Copy_Click"/><TextBox x:Name="FormDetail" IsReadOnly="True" FontFamily="Consolas" AutomationProperties.Name="AoT form identifier"/></DockPanel>
    </Grid>
   </TabItem>
   <TabItem Header="Presets">
    <Grid Margin="16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="270" MinWidth="180"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
       <TextBlock Text="Preset type" Margin="0,0,0,5"/>
       <ComboBox x:Name="PresetCategories" SelectionChanged="PresetFilter_Changed" AutomationProperties.Name="Preset type"/>
       <TextBlock Text="Preset kind" Margin="0,10,0,5"/>
       <ComboBox x:Name="PresetKinds" SelectionChanged="PresetFilter_Changed" AutomationProperties.Name="Preset kind"/>
      </StackPanel>
      <TextBox x:Name="PresetSearch" DockPanel.Dock="Top" Margin="0,0,0,8" TextChanged="PresetFilter_Changed" AutomationProperties.Name="Search presets" ToolTip="Filter preset paths"/><ListBox x:Name="PresetList" DisplayMemberPath="RelativePath" SelectionChanged="Preset_Selected" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></DockPanel>
     <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="#E0E5EC"/>
     <local:PresetWorkspace x:Name="Workspace" Grid.Column="2"/>
    </Grid>
   </TabItem>
   <TabItem Header="Load order"><DockPanel Margin="16"><TextBlock x:Name="LoadOrderInfo" DockPanel.Dock="Top" Margin="0,0,0,12" TextWrapping="Wrap"/><ListBox x:Name="LoadOrderList" FontFamily="Consolas"/></DockPanel></TabItem>
  </TabControl>
  <TextBlock x:Name="Status" Grid.Row="3" Margin="0,12,0,0" Text="Choose your Skyrim Data folder, or launch through MO2 with --data." TextWrapping="Wrap" Foreground="#5B687B"/>
 </Grid>
</Window>
